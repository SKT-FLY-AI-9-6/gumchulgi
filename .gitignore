# ─────────────────────────────────────────────────────────────
# 절대 커밋하면 안 되는 것 — 계정 자격증명
# ─────────────────────────────────────────────────────────────
# sessionid 는 그 계정의 로그인 그 자체다. 비밀번호와 같은 급으로 다룰 것.
# pse_session.py 는 읽은 뒤 파일을 지울지 물어보지만, "n" 을 눌렀거나
# 중간에 죽었으면 평문으로 남는다.
cookies.txt
cookies*.txt
*cookie*.txt
session-*
*.session
.env

# ─────────────────────────────────────────────────────────────
# 영상 데이터 — 용량이 크고 재수집 가능하다
# ─────────────────────────────────────────────────────────────
# manifest.csv 에 shortcode 가 남아 있으면 pse_refetch.py 로 같은 표본을
# 그대로 되살릴 수 있다 (실측: 14편 재수집 성공률 14/14). 그래서 영상 자체는
# 저장소에 넣지 않고 manifest 만 남긴다.
#   reels 88M · reels2 498M · reels_fp 115M · overlays (편당 70~225MB)
reels/
reels2/
reels_fp/
refetch/
overlays/
testclips/
cutclips/
seqclips/
*.mp4
*.mov
*.mkv
*.webm
*.avi

# manifest.csv 도 제외한다 (reels/ 규칙에 이미 포함).
# 표집 근거이자 pse_refetch.py 로 영상을 되살리는 수단이지만, 수집 대상 계정명과
# 게시물 URL — 제3자의 개인정보 — 이 들어 있어 저장소에 넣지 않기로 했다.
# 로컬에는 남아 있으니 재수집이 필요하면 그걸 쓸 것.

# 오버레이 산출물 (mp4 규칙에 이미 걸리지만 명시)
*_overlay.mp4
*_vs_fg_*.mp4
*_vs_hybrid.mp4
*_pse_overlay*.json

# ─────────────────────────────────────────────────────────────
# 파이썬
# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ─────────────────────────────────────────────────────────────
# 임시 파일
# ─────────────────────────────────────────────────────────────
# 앞에 _ 를 붙인 것은 이 프로젝트에서 일회용 스크립트·목록에 쓰는 관례다
_*.py
_*.txt
*.log
peaks/

# ─────────────────────────────────────────────────────────────
# 결과물은 **커밋한다** (아래는 무시하지 않겠다는 기록)
# ─────────────────────────────────────────────────────────────
# final_result.csv      100편 편별 원자료
# reels_result.*        1차 배치 (strict+coherent)
# retry_result.*        MemoryError 재분석분
# reels2_result.*       2차 배치 (strict+hybrid)
# classify.json         위반 원인 분류
# bt1702_recheck.json   BT.1702 교차검증
# hybrid_netgate.json   순방향 게이트 임계 스윕
# 전부 수십 KB 라 저장소에 부담이 없고, 숫자의 근거이므로 영상보다 중요하다.

# 눈으로 확인하려고 검출분만 복사해 둔 폴더 (원본은 reels2/)
detected*/

# ─────────────────────────────────────────────────────────────
# Kim&Moon 브랜치 추가분 — 디플리커 저장소
# ─────────────────────────────────────────────────────────────
# All-In-One-Deflicker 는 **코드와 가중치만** 커밋한다 (약 65MB).
# 클론만 하면 바로 돌아가게 하려는 것 — setup 없이 run 부터 할 수 있다.
# 반면 실행 중 생기는 것은 전부 뺀다. 이 둘이 약 46GB 다.
# 추출 프레임 + 옵티컬 플로우 .npy (약 27GB)
All-In-One-Deflicker/data/
# 학습 중간물 + 결과 png (약 20GB)
All-In-One-Deflicker/results/
# 업스트림 데모 18.5MB, 실행에 불필요
All-In-One-Deflicker/demo.gif
# 업스트림 .gitignore 는 .gitignore.upstream 으로 이름을 바꿔 두었다.
# 그 파일 2~3번째 줄이 results/ 와 pretrained_weights/ 를 막는데, 하위
# .gitignore 가 루트보다 우선하므로 이름을 그대로 두면 여기서 뭘 하든
# 가중치가 커밋에서 빠진다. 되살리려면 다시 .gitignore 로 바꿀 것.
*.bak
_weights_tmp/

# 팀 공통 규칙의 `_*.py` 가 __init__.py 를 막는다 — 패키지가 깨지므로 되살린다
!**/__init__.py

# ensure_ffmpeg() 이 imageio-ffmpeg 번들을 복사해 두는 곳 (수십 MB 바이너리)
bin/

# 파이프라인 산출물 폴더 — 안에 든 건 전부 mp4 라 이미 걸리지만 명시해 둔다
프레임 안줄이고 실행/
10fps로 줄이고 실행/

# 합성 검증 코퍼스 — make_*clips.py 로 언제든 재생성된다
genre/
