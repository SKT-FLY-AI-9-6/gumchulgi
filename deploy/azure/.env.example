# Azure Public IP에 지정한 FQDN. 예: softreel-demo.koreacentral.cloudapp.azure.com
PUBLIC_HOST=replace-me.koreacentral.cloudapp.azure.com

# openssl rand -hex 48
JWT_SECRET=replace-with-a-long-random-secret
TOKEN_DAYS=7
MEDIA_TOKEN_MINUTES=60

AUTH_OPEN=0
ADMIN_EMAIL=admin@example.com
# openssl rand -base64 24
ADMIN_PASSWORD=replace-with-a-strong-password

DAILY_BUDGET_S=300
MAX_UPLOAD_MB=200
MAX_DURATION_S=180
